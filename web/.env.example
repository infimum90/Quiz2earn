# testnet (default) or mainnet
NEXT_PUBLIC_NETWORK=testnet
# Printed by `pnpm deploy:testnet` in /contracts
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Your project's X handle, without @
NEXT_PUBLIC_X_HANDLE=
# Local dev only: point the testnet config at a Hardhat node (http://127.0.0.1:8545)
NEXT_PUBLIC_RPC_URL=
