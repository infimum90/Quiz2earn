# Wallet that deploys and owns the contract. Never commit the real .env.
DEPLOYER_PRIVATE_KEY=0x...
# BOT paid per passed quiz (in BOT, not wei)
REWARD_PER_QUIZ=1
# Correct answers needed to pass (out of 5)
PASS_MARK=4
# BOT sent to the contract right after deploy to fund rewards
INITIAL_FUNDING=20
# Wallet that owns the contract after deploy (your MetaMask address)
OWNER_ADDRESS=
